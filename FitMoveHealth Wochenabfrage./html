<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>FitMove Health</title>
<style>
:root{color-scheme:light dark;--bg:#F6EFE6;--card:#fff;--tx:#2b1f28;--mut:#7a6a74;--ac:#6B2D5C;--ac2:#F0E1EC;--bd:#e4d6cc;--on:#fff;--cor:#D9694B;--gold:#A67C2E;--pfi:#FBE5DD;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#1f1620;--card:#2c2030;--tx:#f6efe6;--mut:#bba9b5;--ac:#d58bbf;--ac2:#4a2a44;--bd:#43344a;--on:#1f1620;--cor:#E8825F;--gold:#d4a95a;--pfi:#3a2430}}
:root[data-theme="dark"]{--bg:#1f1620;--card:#2c2030;--tx:#f6efe6;--mut:#bba9b5;--ac:#d58bbf;--ac2:#4a2a44;--bd:#43344a;--on:#1f1620;--cor:#E8825F;--gold:#d4a95a;--pfi:#3a2430}
*{box-sizing:border-box}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--tx);font:16px/1.5 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif}
main{max-width:560px;margin:0 auto;padding:20px 16px 40px}
.brand{font-size:1.9rem;font-weight:800;color:var(--ac);letter-spacing:.3px;line-height:1.1}
.brand::after{content:"";display:block;width:56px;height:3px;border-radius:2px;background:var(--gold);margin:8px 0 12px}
h1{font-size:1.15rem;margin:0 0 6px;color:var(--cor)}
.sub{color:var(--mut);margin:0 0 18px}
.card{background:var(--card);border:1px solid var(--bd);border-radius:16px;padding:16px;margin-bottom:14px}
.card{border-top:3px solid var(--gold)}
.card h2{font-size:1rem;margin:0 0 10px;color:var(--ac)}
label.q{display:block;font-weight:600;margin:14px 0 8px}
label.q:first-of-type{margin-top:0}
.row{display:flex;gap:6px}
.row button{flex:1;min-height:48px;border:1px solid var(--bd);background:var(--bg);color:var(--tx);border-radius:12px;font-size:1.05rem}
.row button[aria-pressed="true"]{background:var(--ac);border-color:var(--ac);color:var(--on);font-weight:700}
.ends{display:flex;justify-content:space-between;font-size:.8rem;color:var(--mut);margin-top:4px}
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chips button{min-height:44px;padding:0 14px;border:1px solid var(--bd);background:var(--bg);color:var(--tx);border-radius:22px;font-size:.95rem}
.chips button[aria-pressed="true"]{background:var(--ac2);border-color:var(--ac);color:var(--ac);font-weight:700}
input[type=text],textarea{width:100%;font:inherit;color:var(--tx);background:var(--bg);border:1px solid var(--bd);border-radius:12px;padding:12px}
textarea{min-height:84px;resize:vertical}
input[type=range]{width:100%;accent-color:var(--cor);height:40px}
.val{font-weight:700;color:var(--cor)}
.act{display:flex;gap:10px;flex-wrap:wrap}
.act button{flex:1;min-height:52px;border-radius:14px;border:1px solid var(--ac);font-size:1rem;font-weight:700}
.p{background:var(--cor);border-color:var(--cor);color:#fff}
.s{background:transparent;color:var(--ac)}
.note{font-size:.82rem;color:var(--mut);margin-top:12px}
#ok{display:none;color:var(--ac);font-weight:600;margin-top:10px}
</style>
</head>
<body>
<main>
<div class="brand">FitMove Health</div>
<h1>Deine Wochenabfrage</h1>
<p class="sub">Schön, dass du dir kurz Zeit nimmst. Es gibt kein Richtig oder Falsch – ehrliche Antworten helfen mir, dein Training passend für dich anzupassen. Dauer: ca. 3 Minuten.</p>

<div class="card">
<label class="q" for="name">Dein Vorname</label>
<input type="text" id="name" autocomplete="given-name">
<label class="q" for="woche">Woche</label>
<input type="text" id="woche" readonly>
</div>

<div class="card"><h2>Training</h2>
<label class="q">Wie viele Einheiten waren geplant?</label>
<div class="chips" data-single="geplant"></div>
<label class="q">Wie viele hast du geschafft?</label>
<div class="chips" data-single="geschafft"></div>
<div id="scales1"></div>
<label class="q" for="rpe">Wie anstrengend fühlte sich das Training insgesamt an? <span class="val" id="rpev">–</span></label>
<input type="range" id="rpe" min="1" max="10" value="5">
<div class="ends"><span>1 · sehr leicht</span><span>10 · am Limit</span></div>
</div>

<div class="card"><h2>Wie geht es dir?</h2>
<div id="scales2"></div>
<label class="q">Was hat mich diese Woche beschäftigt?</label>
<div class="chips" id="sym"></div>
<label class="q">Gab es Schmerzen oder Beschwerden durch das Training?</label>
<div class="chips" data-single="schmerz"></div>
<label class="q" for="schmerzt">Wo oder was? (optional)</label>
<input type="text" id="schmerzt">
</div>

<div class="card"><h2>In deinen Worten</h2>
<label class="q" for="gut">Was lief gut?</label>
<textarea id="gut"></textarea>
<label class="q" for="schwer">Was war schwierig oder hat gefehlt?</label>
<textarea id="schwer"></textarea>
<label class="q" for="wunsch">Wünsche oder Fragen für die nächste Woche</label>
<textarea id="wunsch"></textarea>
</div>

<div class="card">
<div class="act">
<button class="p" id="pdf">Als PDF senden</button>
<button class="s" id="share">Als Text teilen</button>
<button class="s" id="copy">Text kopieren</button>
</div>
<div id="ok"></div>
<p class="note">Tippe auf „Als PDF senden“ (oder „Als Text teilen“) und wähle den Kanal, über den du mir sonst schreibst (z. B. WhatsApp oder E-Mail). Deine Antworten werden nicht automatisch gespeichert, sondern nur an die Person gesendet, die du auswählst. Diese Abfrage ersetzt keine ärztliche Abklärung – bei anhaltenden oder starken Beschwerden sprich bitte mit deiner Ärztin oder deinem Arzt.</p>
</div>
</main>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script>
(function(){
var A={};
var S1=[["umsetzung","Wie gut konnte ich das Training umsetzen?","gar nicht","sehr gut"]];
var S2=[["energie","Mein Energielevel","erschöpft","voller Energie"],["schlaf","Mein Schlaf","sehr schlecht","sehr gut"],["stimmung","Meine Stimmung","gedrückt","sehr gut"],["stress","Mein Stresslevel","kaum","sehr hoch"],["ernaehrung","Umsetzung der Ernährung","gar nicht","sehr gut"]];
var FACE=["😞","🙁","😐","🙂","😊"];
var SYM=["Hitzewallungen","Schlafprobleme","Gelenkschmerzen","Stimmungsschwankungen","Erschöpfung","Heißhunger","Beckenboden / Blase","Kopfschmerzen","Herzklopfen","Nichts davon"];
var SLB={};
function build(id,list){
 var h="";
 list.forEach(function(s){
  h+='<label class="q">'+s[1]+'</label><div class="row" data-sc="'+s[0]+'">';
  for(var i=1;i<=5;i++)h+='<button type="button" data-v="'+i+'" aria-pressed="false">'+FACE[i-1]+'</button>';
  h+='</div><div class="ends"><span>1 · '+s[2]+'</span><span>5 · '+s[3]+'</span></div>';
  SLB[s[0]]=s[1];
 });
 document.getElementById(id).innerHTML=h;
}
build("scales1",S1);build("scales2",S2);
function chips(el,items){el.innerHTML=items.map(function(t){return '<button type="button" aria-pressed="false">'+t+'</button>'}).join("")}
var nums=["0","1","2","3","4","5","6+"];
chips(document.querySelector('[data-single=geplant]'),nums);
chips(document.querySelector('[data-single=geschafft]'),nums);
chips(document.querySelector('[data-single=schmerz]'),["Nein","Leicht","Deutlich"]);
chips(document.getElementById("sym"),SYM);
document.addEventListener("click",function(e){
 var b=e.target.closest("button");if(!b)return;
 var sc=b.parentNode.getAttribute("data-sc");
 if(sc){[].forEach.call(b.parentNode.children,function(x){x.setAttribute("aria-pressed","false")});b.setAttribute("aria-pressed","true");A[sc]=b.getAttribute("data-v");return}
 var sg=b.parentNode.getAttribute("data-single");
 if(sg){[].forEach.call(b.parentNode.children,function(x){x.setAttribute("aria-pressed","false")});b.setAttribute("aria-pressed","true");A[sg]=b.textContent;return}
 if(b.parentNode.id==="sym"){var on=b.getAttribute("aria-pressed")==="true";b.setAttribute("aria-pressed",on?"false":"true")}
});
var r=document.getElementById("rpe"),rv=document.getElementById("rpev");
r.addEventListener("input",function(){A.rpe=r.value;rv.textContent=r.value});
function kw(d){var t=new Date(Date.UTC(d.getFullYear(),d.getMonth(),d.getDate()));var n=t.getUTCDay()||7;t.setUTCDate(t.getUTCDate()+4-n);var y=new Date(Date.UTC(t.getUTCFullYear(),0,1));return Math.ceil(((t-y)/864e5+1)/7)}
var now=new Date();
document.getElementById("woche").value="KW "+kw(now)+" · "+now.toLocaleDateString("de-DE");
function v(id){return (document.getElementById(id).value||"").trim()}
function text(){
 var L=["FitMove Health · Wochenabfrage","Name: "+(v("name")||"–"),"Woche: "+v("woche"),"","TRAINING"];
 L.push("Einheiten: "+(A.geschafft||"–")+" von "+(A.geplant||"–")+" geplant");
 L.push("Umsetzung (1–5): "+(A.umsetzung||"–"));
 L.push("Anstrengung (1–10): "+(A.rpe||"–"));
 L.push("Beschwerden beim Training: "+(A.schmerz||"–")+(v("schmerzt")?" ("+v("schmerzt")+")":""));
 L.push("","BEFINDEN (1–5)");
 S2.forEach(function(s){L.push(s[1]+": "+(A[s[0]]||"–"))});
 var sy=[].filter.call(document.querySelectorAll("#sym button"),function(x){return x.getAttribute("aria-pressed")==="true"}).map(function(x){return x.textContent});
 L.push("Beschäftigt hat mich: "+(sy.join(", ")||"–"));
 L.push("","Lief gut: "+(v("gut")||"–"),"Schwierig/gefehlt: "+(v("schwer")||"–"),"Wünsche/Fragen: "+(v("wunsch")||"–"));
 return L.join("\n");
}
var ok=document.getElementById("ok");
function msg(t){ok.textContent=t;ok.style.display="block"}
function cp(t){
 if(navigator.clipboard&&navigator.clipboard.writeText){return navigator.clipboard.writeText(t).then(function(){msg("Text kopiert – jetzt in deinen Chat einfügen. Danke dir! 🌸")}).catch(fb)}
 fb();function fb(){var a=document.createElement("textarea");a.value=t;document.body.appendChild(a);a.select();try{document.execCommand("copy");msg("Text kopiert – jetzt in deinen Chat einfügen. Danke dir! 🌸")}catch(x){msg("Kopieren hat nicht geklappt.")}document.body.removeChild(a)}
}
document.getElementById("copy").addEventListener("click",function(){cp(text())});
document.getElementById("share").addEventListener("click",function(){
 var t=text();
 if(navigator.share){navigator.share({text:t}).then(function(){msg("Vielen Dank für deine Rückmeldung! 🌸")}).catch(function(e){if(e&&e.name!=="AbortError")cp(t)})}
 else cp(t);
});

document.getElementById("pdf").addEventListener("click",function(){
 try{
  if(!window.jspdf){msg("PDF-Funktion nicht geladen – bitte „Als Text teilen“ nutzen.");return}
  var t=text().replace(/[–·]/g,"-");
  var d=new window.jspdf.jsPDF({unit:"mm",format:"a4"});
  var y=20,lines=t.split("\n");
  d.setFontSize(16);d.setFont("helvetica","bold");d.text("FitMove Health - Wochenabfrage",15,y);y+=10;
  d.setFontSize(11);
  lines.slice(1).forEach(function(l){
   var head=/^[A-ZÄÖÜ ()0-9-]+$/.test(l)&&l.length>2;
   d.setFont("helvetica",head?"bold":"normal");
   d.splitTextToSize(l,180).forEach(function(p){if(y>280){d.addPage();y=20}d.text(p,15,y);y+=6});
   if(!l)y-=2;
  });
  var nm=(v("name")||"Teilnehmerin").replace(/[^A-Za-z0-9ÄÖÜäöüß]/g,"");
  var fn="Wochenabfrage_"+nm+"_"+v("woche").split(" ")[1]+".pdf";
  var blob=d.output("blob"),f=new File([blob],fn,{type:"application/pdf"});
  if(navigator.canShare&&navigator.canShare({files:[f]})){
   navigator.share({files:[f]}).then(function(){msg("Vielen Dank für deine Rückmeldung! 🌸")}).catch(function(e){if(e&&e.name!=="AbortError"){d.save(fn);msg("PDF gespeichert – bitte aus deinen Downloads verschicken.")}});
  }else{d.save(fn);msg("PDF gespeichert – bitte aus deinen Downloads verschicken.")}
 }catch(e){msg("PDF konnte nicht erstellt werden – bitte „Als Text teilen“ nutzen.")}
});
})();
</script>
</body>
</html>


